+def span_checkpoint_payload(model, optimizer, step, parent_identity):
+    """Save the small head with the exact frozen-parent and source-mode contract."""
+    return dict(source_mode=model.mixer.source_mode,
+                mixer_state=model.mixer.state_dict(),
+                optimizer=optimizer.state_dict(), step=step,
+                parent_identity=parent_identity)
+
+
+def restore_span_checkpoint(model, optimizer, payload, parent_identity):
+    """Restore only against the same parent and the same evidence source."""
+    assert payload['source_mode'] == model.mixer.source_mode
+    assert payload['parent_identity'] == parent_identity
+    model.mixer.load_state_dict(payload['mixer_state'], strict=True)
+    optimizer.load_state_dict(payload['optimizer'])
+    return payload['step']
